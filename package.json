{
  "name": "koster",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Костёр — портативная программа для игры в D&D 5e (2014) на русском языке",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @koster/desktop",
    "build": "npm run build -w @koster/desktop",
    "dist": "npm run dist -w @koster/desktop",
    "catalog:build": "npm run catalog:build -w @koster/importer --",
    "catalog:fetch": "npm run catalog:fetch -w @koster/importer --",
    "catalog:compare-legacy": "npm run catalog:compare-legacy -w @koster/importer --",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
