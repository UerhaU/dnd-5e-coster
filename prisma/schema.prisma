generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  displayName      String
  defaultRole      String            @default("player")
  authCode         String?           @unique
  isLocal          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaignsOwned   Campaign[]        @relation("CampaignOwner")
  campaignMembers  CampaignMember[]
  characterLibrary CharacterLibrary?
  characters       Character[]
  roomsHosted      GameRoom[]        @relation("RoomHost")
  roomParticipants RoomParticipant[]
  snapshots        SaveSnapshot[]
  homebrewContents HomebrewContent[] @relation("HomebrewOwner")
}

model Setting {
  id            String     @id @default(cuid())
  slug          String     @unique
  titleRu       String
  titleOriginal String?
  description   String?
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
  rooms         GameRoom[]
}

model SourceBook {
  id                   String                   @id @default(cuid())
  fileName             String?                  @unique
  filePath             String?
  titleRu              String
  titleOriginal        String?
  sourceType           String                   @default("unknown")
  language             String                   @default("unknown")
  quality              String                   @default("verified")
  editionCompatibility String                   @default("unknown")
  sourcePriority       String                   @default("book_only")
  isCore               Boolean                  @default(false)
  isOfficial           Boolean                  @default(true)
  isEnabledByDefault   Boolean                  @default(true)
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  campaignLinks        CampaignSourceBook[]
  roomOverrides        RoomSourceBookOverride[]
  importedContents     ImportedContent[]
}

model ImportedContent {
  id                   String      @id @default(cuid())
  canonicalId          String      @unique
  category             String
  siteId               String?
  russianName          String
  englishName          String?
  sourceTitle          String?
  sourceBookId         String?
  sourceUrl            String?
  entityUrl            String
  sourcePriority       String      @default("site")
  editionCompatibility String      @default("unknown")
  reviewStatus         String      @default("unchecked")
  mechanicsJson        String      @default("{}")
  payloadJson          String      @default("{}")
  importedAt           DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  sourceBook           SourceBook? @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([sourceBookId])
  @@index([editionCompatibility])
  @@index([reviewStatus])
}

model Campaign {
  id              String                   @id @default(cuid())
  name            String
  description     String?
  ownerId         String
  settingId       String?
  status          String                   @default("active")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  owner           User                     @relation("CampaignOwner", fields: [ownerId], references: [id])
  setting         Setting?                 @relation(fields: [settingId], references: [id])
  members         CampaignMember[]
  parties         Party[]
  rooms           GameRoom[]
  sourceBooks     CampaignSourceBook[]
  characterStates CampaignCharacterState[]
  snapshots       SaveSnapshot[]
  turnEncounters  TurnEncounter[]
  merchants       Merchant[]
  theftRequests   TheftRequest[]
  legacyHomebrewContents HomebrewContent[]         @relation("LegacyCampaignHomebrew")
  homebrewLinks          CampaignHomebrewContent[]
  npcProfiles      NpcProfile[]
  npcTheftRequests NpcTheftRequest[]
  noteDocuments    NoteDocument[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  role       String   @default("player")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model Party {
  id         String      @id @default(cuid())
  campaignId String
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characters Character[]
  rooms      GameRoom[]
}

model GameRoom {
  id              String                   @id @default(cuid())
  campaignId      String
  partyId         String?
  hostUserId      String
  settingId       String?
  name            String
  status          String                   @default("open")
  inviteCode      String                   @unique
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  campaign        Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  party           Party?                   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  hostUser        User                     @relation("RoomHost", fields: [hostUserId], references: [id])
  setting         Setting?                 @relation(fields: [settingId], references: [id])
  participants    RoomParticipant[]
  sourceOverrides RoomSourceBookOverride[]
  turnEncounters  TurnEncounter[]
}

model RoomParticipant {
  id          String     @id @default(cuid())
  roomId      String
  userId      String
  characterId String?
  role        String     @default("player")
  status      String     @default("joined")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  room        GameRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
}

model CharacterLibrary {
  id         String      @id @default(cuid())
  ownerId    String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  characters Character[]
}

model Character {
  id             String                   @id @default(cuid())
  ownerId        String
  libraryId      String?
  partyId        String?
  name           String
  kind           String                   @default("player")
  level          Int                      @default(1)
  ancestry       String?
  className      String?
  portraitUrl    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  owner          User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  library        CharacterLibrary?        @relation(fields: [libraryId], references: [id])
  party          Party?                   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  sheetState     CharacterSheetState?
  campaignStates CampaignCharacterState[]
  roomSlots      RoomParticipant[]
}

model CharacterSheetState {
  id          String    @id @default(cuid())
  characterId String    @unique
  currentHp   Int       @default(10)
  maxHp       Int       @default(10)
  armorClass  Int       @default(10)
  speed       Int       @default(30)
  sheetJson   String    @default("{}")
  autosavedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CampaignCharacterState {
  id               String            @id @default(cuid())
  campaignId       String
  characterId      String
  level            Int               @default(1)
  currentHp        Int               @default(10)
  maxHp            Int               @default(10)
  armorClass       Int               @default(10)
  speed            Int               @default(30)
  inventoryJson    String            @default("[]")
  sheetJson        String            @default("{}")
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character        Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  turnParticipants TurnParticipant[]

  @@unique([campaignId, characterId])
}

model CampaignSourceBook {
  id           String     @id @default(cuid())
  campaignId   String
  sourceBookId String
  isEnabled    Boolean    @default(true)
  language     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceBook   SourceBook @relation(fields: [sourceBookId], references: [id], onDelete: Cascade)

  @@unique([campaignId, sourceBookId])
}

model RoomSourceBookOverride {
  id           String     @id @default(cuid())
  roomId       String
  sourceBookId String
  isEnabled    Boolean
  language     String?
  reason       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  room         GameRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sourceBook   SourceBook @relation(fields: [sourceBookId], references: [id], onDelete: Cascade)

  @@unique([roomId, sourceBookId])
}

model SaveSnapshot {
  id          String    @id @default(cuid())
  scope       String
  scopeId     String
  summary     String
  payloadJson String    @default("{}")
  campaignId  String?
  userId      String?
  createdAt   DateTime  @default(now())
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TurnEncounter {
  id               String            @id @default(cuid())
  campaignId       String
  roomId           String?
  name             String
  status           String            @default("active")
  round            Int               @default(1)
  currentTurnIndex Int               @default(0)
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  room             GameRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants     TurnParticipant[]
  effects          TurnEffect[]
}

model TurnParticipant {
  id               String                  @id @default(cuid())
  encounterId      String
  characterStateId String?
  name             String
  kind             String                  @default("player")
  initiative       Int                     @default(10)
  turnOrder        Int                     @default(0)
  armorClass       Int                     @default(10)
  currentHp        Int                     @default(1)
  maxHp            Int                     @default(1)
  speed            Int                     @default(30)
  movementLimit    Int                     @default(30)
  movementUsed     Int                     @default(0)
  actionUsed       Boolean                 @default(false)
  bonusActionUsed  Boolean                 @default(false)
  reactionUsed     Boolean                 @default(false)
  isActive         Boolean                 @default(true)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  encounter        TurnEncounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  characterState   CampaignCharacterState? @relation(fields: [characterStateId], references: [id], onDelete: SetNull)
  effects          TurnEffect[]
}

model TurnEffect {
  id              String           @id @default(cuid())
  encounterId     String
  participantId   String?
  name            String
  durationType    String           @default("rounds")
  remainingRounds Int              @default(1)
  timing          String           @default("end_of_turn")
  isActive        Boolean          @default(true)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  encounter       TurnEncounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  participant     TurnParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
}

model Merchant {
  id                 String         @id @default(cuid())
  campaignId         String
  name               String
  description        String?
  status             String         @default("active")
  activeBuyerStateId String?
  inventoryJson      String         @default("{}")
  priceMultiplier    Float          @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  campaign           Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theftRequests      TheftRequest[]
}

model TheftRequest {
  id               String   @id @default(cuid())
  campaignId       String
  merchantId       String
  characterStateId String
  requesterUserId  String?
  itemId           String?
  itemName         String
  status           String   @default("pending")
  dc               Int      @default(12)
  roll             Int?
  notes            String?
  resolution       String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model HomebrewContent {
  id            String                    @id @default(cuid())
  campaignId    String?
  ownerId       String?
  name          String
  kind          String
  status        String                    @default("draft")
  payloadJson   String                    @default("{}")
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  legacyCampaign Campaign?                @relation("LegacyCampaignHomebrew", fields: [campaignId], references: [id], onDelete: SetNull)
  owner         User?                     @relation("HomebrewOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaignLinks CampaignHomebrewContent[]

  @@index([ownerId])
  @@index([campaignId])
}

model CampaignHomebrewContent {
  id                String          @id @default(cuid())
  campaignId        String
  homebrewContentId String
  createdAt         DateTime        @default(now())
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  homebrewContent   HomebrewContent @relation(fields: [homebrewContentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, homebrewContentId])
  @@index([homebrewContentId])
}

model NpcProfile {
  id            String            @id @default(cuid())
  campaignId    String
  name          String
  sourceType    String            @default("manual")
  role          String?
  socialClass   String            @default("commoner")
  wealthTier    String            @default("modest")
  isActive      Boolean           @default(false)
  statJson      String            @default("{}")
  inventoryJson String            @default("{}")
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  theftRequests NpcTheftRequest[]
}

model NpcTheftRequest {
  id               String     @id @default(cuid())
  campaignId       String
  npcId            String
  characterStateId String
  requesterUserId  String?
  itemId           String?
  itemName         String
  status           String     @default("pending")
  dc               Int        @default(12)
  roll             Int?
  notes            String?
  resolution       String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  campaign         Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  npc              NpcProfile @relation(fields: [npcId], references: [id], onDelete: Cascade)
}

model NoteDocument {
  id              String   @id @default(cuid())
  campaignId      String
  ownerStateId    String?
  title           String
  textContent     String   @default("")
  drawingJson     String   @default("[]")
  historyJson     String   @default("[]")
  inkUsed         Int      @default(0)
  isShownToGm     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}
