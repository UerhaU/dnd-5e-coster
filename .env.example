DATABASE_URL="file:../storage/dnd.sqlite"

# Optional local prototype profile settings. VITE_* values are visible in the
# browser bundle and are NOT secure authentication or server-side secrets.
# Without overrides, both ERHA and ERHACHECK use the public demo password: demo.
VITE_LOCAL_PLAYER_1_PASSWORD=demo
VITE_LOCAL_PLAYER_2_PASSWORD=demo
VITE_LOCAL_CONTACT_EMAIL=
